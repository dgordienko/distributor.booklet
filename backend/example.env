PORT=4000
DATABASE_URL="file:./dev.db"
UPLOADS_DIR="./uploads"

# Writes (POST/PUT/PATCH/DELETE) require an Auth0 access token; reads are public.
# Local development: skip token validation. Never set this in production.
AUTH_DISABLED=true

# Production-like local setup instead of AUTH_DISABLED:
# AUTH0_ISSUER_BASE_URL=https://your-tenant.auth0.com/
# AUTH0_AUDIENCE=https://booklet-api

# External devices API for the "sync teams" button (optional).
# DEVICES_API_URL=http://<devices-api-host>:8089/api/devices
