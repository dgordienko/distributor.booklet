# Copy to admin-web/.env for local development (npm run dev:admin).
# Vite inlines VITE_* into the bundle at build time.

# Auth0 SPA application. Allow http://localhost:5173 in its Callback URLs,
# Logout URLs and Web Origins.
VITE_AUTH0_DOMAIN=your-tenant.auth0.com
VITE_AUTH0_CLIENT_ID=<auth0-spa-client-id>

# Auth0 API identifier. The admin requests an access token for it and sends
# it on writes. Not needed if the local backend runs with AUTH_DISABLED=true.
# VITE_AUTH0_AUDIENCE=https://booklet-api
